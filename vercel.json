{
    "version": 2,
    "builds": [
      {
        "src": "server/index.ts",
        "use": "@vercel/node"
      },
      {
        "src": "client/package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "client/dist"
        }
      }
    ],
    "routes": [
      { "src": "/server/(.*)", "dest": "/server/index.ts" },
      { "src": "/(.*)", "dest": "/client/$1" }
    ]
  }
  